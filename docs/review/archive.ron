        (
            question: (
                id: "number-field-default",
                title: "What does a middle click reset a settings field to?",
                source: "Phase 5, brief U-8b middle-click reset (docs/briefs/U-8b-middle-click-reset.md)",
                description: r#"Brief U-8b gives every number field a default. Edit-seam fields had one already. Settings rows and panel inputs had none. Some settings (render, lighting, scenery) are also reset as a group when a look is applied, so two defaults exist for them: the type's start-up value and the active look's preset."#,
                decision: true,
                options: [
