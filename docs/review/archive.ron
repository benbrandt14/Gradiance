            question: (
                id: "group-overlap",
                title: "What does grouping a body that is already in a group do?",
                source: "brief A-1 Findings 8 (selection); brief A-2",
                description: r#"Groups are stacks of ids on each body, innermost first, and are meant to nest. Grouping pushed a fresh id onto each target only, so grouping one member of a group with an outside body put that member in two sibling groups (the panel then drew one nested under the other), and grouping part of a group pushed the new group outside the larger one. The viewport selects whole outermost groups, so this was reached through the group verb, the Groups panel chips (which select exactly) and scripts."#,
                decision: true,
                options: [
                    (
                        label: "Close over: a member brings its group",
                        caption: r#"Recommended. A group the new set only partly holds joins it whole (as a viewport click selects it), repeated until nothing overlaps; a set inside one group nests inside it. No existing group changes membership; one undo step. Cost: grouping one wheel of a car with the ground groups the whole car with it."#,
                    ),
                    (
                        label: "Re-parent the member",
                        caption: r#"Take the picked member out of its old group into the new one. Edits an existing group silently, can leave a one-body group, and loses the member's inner groups."#,
                    ),
                    (
                        label: "Refuse",
                        caption: r#"Report no effect when a target's group is only partly picked. Safe, but the Groups panel's chips and scripts then cannot group a filter result that cuts across a group."#,
                    ),
                ],
            ),
            answer: (
                question: "group-overlap",
                title: "What does grouping a body that is already in a group do?",
