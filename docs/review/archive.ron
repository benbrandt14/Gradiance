            question: (
                id: "shading",
                title: "Which shading should be the default look?",
                source: "Phase 4b, 4b-3 art direction (input for its presets; SSAO options)",
                description: r#"The same scene under three render settings. Toon banding is today's default. Smooth shading is plain matte PBR. SSAO adds screen-space ambient occlusion, darkening contacts and creases; it turns MSAA off, so edges alias more, and it costs frame time.

Settings are global, so these options can only be flipped one at a time, not shown side by side. In the straight-on view the front faces look alike: press play and orbit the view (middle-drag) to see the sides and contacts, where the options differ. Body colours are re-rolled on every load (scripts cannot set a colour yet), so judge the shading, not the hues. 4b-3 builds 2-3 presets from this answer."#,
                options: [
                    (
                        label: "Toon (today)",
                        caption: "Four light bands with a rim light, no SSAO.",
                        scripts: ["scenes/shading/scene.scm"],
                    ),
                    (
                        label: "Smooth",
                        caption: "Toon banding off: continuous matte shading, same lights.",
                        scripts: ["scenes/shading/scene.scm"],
                        settings: (render: (toon_enabled: false)),
                    ),
                    (
                        label: "Toon + SSAO",
                        caption: "Today's toon bands plus screen-space ambient occlusion.",
                        scripts: ["scenes/shading/scene.scm"],
                        settings: (lighting: (ssao: true)),
                    ),
                ],
            ),
            answer: (
                question: "shading",
                title: "Which shading should be the default look?",
                choice: Picked("Toon (today)"),
                note: "A future revamp of the visuals will be required. The initial build-out was not able to take screenshots. Some other aspects of 2D lighting ( like the 2d lighting bevy crate) would probably be good too. The toon banding has never really been observed because of the flat lighting.",
                answered_at: "2026-11-17T01:56:09Z",
                revision: "32d084f15193",
