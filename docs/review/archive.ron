            question: (
                id: "union-field-cull-inside",
                title: "What do we do about UnionField skipping a leaf whose box holds the point?",
                source: "Geometry property tests (docs/briefs/6-2-geometry-proptests.md)",
                description: r#"UnionField culled a leaf when the distance to its box was at least the best field so far plus a margin. Inside the box that distance is 0, so once the best was negative the leaf was skipped although its field could be lower. The sign was always right, so contours did not change; the value was not the tree's field, which its docs promise bit for bit."#,
                decision: true,
                options: [
                    (
                        label: "Fix it: cull only outside the box",
                        caption: r#"Skip a leaf only when the point is outside its box and that distance beats the best. The evaluation is exact again; the cull still skips every far leaf."#,
                    ),
                    (
                        label: "Document it as a sign-only field",
                        caption: r#"Keeps a little speed inside overlapping leaves, but the field would no longer be usable for distances."#,
                    ),
                ],
            ),
            answer: (
                question: "union-field-cull-inside",
