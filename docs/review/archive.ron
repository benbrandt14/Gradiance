            question: (
                id: "spring-authoring",
                title: "How is a spring authored: N/m, or frequency and damping ratio?",
                source: "brief 4b-4 Facts and Decisions",
                description: r#"A spring was authored as stiffness (N/m) and damping, with the tool sizing the stiffness from the body's area (density ignored) and no damping. The same stiffness bounces at different periods on different masses, so a default could not suit a pebble and a truck at once, and a density edit changed a spring's feel."#,
                decision: true,
                options: [
                    (
                        label: "Frequency + damping ratio (mass-relative)",
                        caption: r#"Recommended. Author Hz and a ratio; the physics seam derives N/m from the reduced mass every frame (never saved). One default behaves on every body, and a density edit keeps the period. Costs a format bump (v8, v7 rejected), the `spring` verb's arguments change, and N/m is no longer typed directly."#,
                    ),
                    (
                        label: "N/m with mass-scaled defaults",
                        caption: r#"Keep N/m; the tool and the inspector's reset compute k from the real mass. No format change, but a density or size edit after creation changes the period, and a scripted N/m value stops behaving when the shape changes."#,
                    ),
                ],
            ),
