            question: (
                id: "sketch-resolution",
                title: "How does the field contour keep a thin stroke whole within the polygonize budget?",
                source: "Brief N-6 sketch tool (docs/briefs/N-6-sketch-tool.md)",
                description: r#"polygonize samples a CSG tree at extent / 96 along its larger side; a 10 cm stroke across a 6 m drawing is thinner than one cell and would break apart."#,
                decision: true,
                options: [
                    (
                        label: "Finer cells for capsule trees, same sample budget",
                        caption: r#"sdf::thinnest_solid finds the narrowest capsule on the solid side of a tree (a subtracted cut stroke does not count); polygonize::field_cell then asks for 3 cells across it, but never more samples over the box than a square tree takes today (96 x 96) and never a coarser cell than before. Trees without a capsule are contoured exactly as before. A stroke too thin for its drawing's size (a 12 m scribble at 2 cm) is widened by the sketch until it is 2 cells across (resolvable_radius). A union of placed exact leaves is evaluated by sdf::UnionField: the same values bit for bit, rotations precomputed and far leaves skipped by their boxes (a 24-leaf sketch contours in about 3 ms at dev opt-level 1, against 0.7 ms for a box minus a circle)."#,
                    ),
                    (
                        label: "A fixed finer grid",
                        caption: r#"A finer global FIELD_CELLS: every CSG body pays, every frame (borders re-contour each frame)."#,
                    ),
                ],
            ),
            answer: (
                question: "sketch-resolution",
