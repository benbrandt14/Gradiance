            question: (
                id: "toon-face-field",
                title: "Where does a front face's rounded normal come from?",
                source: "Brief 4b-6 toon ramp (docs/briefs/4b-6-toon-ramp.md)",
                description: r#"The brief wants the falloff to come from the shape: a pillow or bevel normal from the distance to the outline. A front cap's vertices all lie on its outline, so no vertex attribute can carry that distance."#,
                decision: true,
                options: [
                    (
                        label: "Baked face field",
