;; Shared by every `shading` option: a ground and a small pile of shapes
;; with corners, curves and contacts -- where banding, rim light and
;; ambient occlusion show. Options differ only in render/lighting settings.
(spawn-ground 0 -2.5 0)
(spawn-box -3 -2 1 1)
(spawn-box -3 -1.1 0.8 0.8)
(spawn-box-rot -1.4 -2.1 1.2 0.8 0.3)
(spawn-circle 0.3 -2 0.5)
(spawn-circle 1.3 -2.2 0.3)
(spawn-box 3 -1.5 0.4 2)
(spawn-box-rot 2.2 -0.3 2.4 0.2 -0.3)
