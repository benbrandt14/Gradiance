;; Shared by every `fluid-look` option: a wide pool with three floaters
;; (a box, a ball and a plank at half the water's density), and a narrow
;; tank on the right with a heavy ball that sinks through it. The fluids
;; are made in water.scm, a frame later, once these bodies have indices.
;; Options differ only in the render setting `fluid_look`.
(spawn-ground 0 -3.2 0)
(spawn-box -1.2 -1.7 6 3)
(spawn-box 4 -1.7 1.8 3)
(spawn-box -3 0.6 0.9 0.9)
(spawn-circle -1 0.8 0.45)
(spawn-box 0.8 0.6 1.6 0.35)
(spawn-circle 4 1.5 0.35)
